<Window x:Class="RekenmachineWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RekenmachineWpf"
        mc:Ignorable="d"
        Title="Rekenmachine" Height="450" Width="400" ResizeMode="NoResize">

    <Grid >

        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- DISPLAY -->
        <Border Grid.Row="0"
                Background="#AAAAAA"
                BorderBrush="#111111"
                BorderThickness="1"
                CornerRadius="4">

            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titel -->
                <Border Background="#111111" CornerRadius="4,4,0,0">
                    <TextBlock Text="Rekenmachine"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                </Border>

                
                    <TextBlock x:Name="SomTekst"
                       Grid.Row="1"
                       Text=""
                       Foreground="Black"
                       FontSize="12"
                       FontWeight="Bold"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left"
                       Margin="5"/>

                    <TextBlock x:Name="AntwoordTekst"
                       Grid.Row="1"
                       Text=""
                       Foreground="Black"
                       FontSize="25"
                       FontWeight="DemiBold"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left"
                       Margin="5,25,5,5"/>       

               
                
                

                </Grid>
        </Border>

        <!-- KNOPPEN -->
        <UniformGrid Grid.Row="1"
                     Rows="5"
                     Columns="4"
                     >

            <Button Content="7" Click="Btn_Click"/>
            <Button Content="8" Click="Btn_Click"/>
            <Button Content="9" Click="Btn_Click"/>
            <Button Content="*" Click="Btn_Click"/>

            <Button Content="4" Click="Btn_Click"/>
            <Button Content="5" Click="Btn_Click"/>
            <Button Content="6" Click="Btn_Click"/>
            <Button Content="-" Click="Btn_Click"/>

            <Button Content="1" Click="Btn_Click"/>
            <Button Content="2" Click="Btn_Click"/>
            <Button Content="3" Click="Btn_Click"/>
            <Button Content="/" Click="Btn_Click"/>

            <Button Content="+/-" Click="Btn_Click"/>
            <Button Content="0" Click="Btn_Click"/>
            <Button Content="," Click="Btn_Click"/>
            <Button Content="+" Click="Btn_Click"/>

            <Button Content="C" Click="Btn_Click"/>
            <Button Content="«" Click="Btn_Click"/>
            <Button Content="π" Click="Btn_Click"/>
            <Button Content="=" Click="Btn_Click"/>

        </UniformGrid>
    </Grid>
</Window>
