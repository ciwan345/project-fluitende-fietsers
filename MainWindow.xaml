<Window x:Class="de_rekenmachine_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:de_rekenmachine_project"
        mc:Ignorable="d"
        
        Title="Rekenmachine" Height="525" Width="500">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.ColumnSpan="4" Orientation="Vertical" Background="Gray">
            <TextBlock Height="25" Margin="2" FontSize="16" Name="resultaat"/>
            <TextBlock Height="55" Margin="2" FontSize="40" Name="grootresultaat"/>
        </WrapPanel>

        <Button Grid.Row="1" Grid.Column="0" Content="7" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="1" Grid.Column="1" Content="8" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="1" Grid.Column="2" Content="9" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="1" Grid.Column="3" Content="*" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Operator_Click"/>

        <Button Grid.Row="2" Grid.Column="0" Content="4" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="2" Grid.Column="1" Content="5" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="2" Grid.Column="2" Content="6" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="2" Grid.Column="3" Content="-" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Operator_Click"/>

        <Button Grid.Row="3" Grid.Column="0" Content="1" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="3" Grid.Column="1" Content="2" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="3" Grid.Column="2" Content="3" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="3" Grid.Column="3" Content="/" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Operator_Click"/>

        <Button Grid.Row="4" Grid.Column="0" Content="+/-" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="ClickNegate"/>
        <Button Grid.Row="4" Grid.Column="1" Content="0" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="clicknummer"/>
        <Button Grid.Row="4" Grid.Column="2" Content="," FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="ClickKomma"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Operator_Click"/>

        <Button Grid.Row="5" Grid.Column="0" Content="C" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Clickweg"/>
        <Button Grid.Row="5" Grid.Column="1" Content=">>" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Clickongedaan"/>
        <Button Grid.Row="5" Grid.Column="2" Content="π" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="ClickPi"/>
        <Button Grid.Row="5" Grid.Column="3" Content="=" FontSize="20" Background="DarkGray" BorderBrush="Black" BorderThickness="1.5" Click="Clickgelijk"/>

    </Grid>


</Window>
