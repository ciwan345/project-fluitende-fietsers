<Window x:Class="DeFluitendeFietser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="De Fluitende Fietser " Height="780" Width="1200"
        MinHeight="680" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="#F3F5F7" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#20364B"/>
        <SolidColorBrush x:Key="Green" Color="#21856B"/>
        <SolidColorBrush x:Key="Light" Color="#F3F5F7"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#D7DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Navigatie -->
        <Border Grid.Column="0" Background="#20364B">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="20,26,16,28">
                    <TextBlock Text="DE FLUITENDE" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="FIETSER" Foreground="#75D1B2" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="WINKEL KASSA" Foreground="#B9C8D3" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="🛒   Bestellen" Tag="Order" Click="Nav_Click" Background="#21856B" Foreground="White" HorizontalContentAlignment="Left" Margin="12,3"/>
                    <Button Content="💶   Betalen" Tag="Payment" Click="Nav_Click" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Margin="12,3"/>
                    <Button Content="👥   Klanten" Click="Customers_Click" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Margin="12,3"/>
                    <Button Content="＋   Rekenmachine" Tag="Calculator" Click="Nav_Click" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Margin="12,3"/>
                    <Button Content="◷   Klok" Tag="Clock" Click="Nav_Click" Background="Transparent" Foreground="White" HorizontalContentAlignment="Left" Margin="12,3"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Bestelling" FontSize="27" FontWeight="Bold" Foreground="#20364B"/>
                    <TextBlock x:Name="PageSubtitle" Text="Maak een bestelling voor de klant" FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Bestelscherm -->
            <Grid x:Name="OrderPage" Grid.Row="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Product toevoegen" FontSize="19" FontWeight="Bold" Foreground="#20364B" Margin="0,0,0,16"/>
                            <TextBlock Text="Fietsen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="BikeCombo" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" MaxDropDownHeight="320" SelectionChanged="ProductCombo_SelectionChanged" Margin="0,0,0,14"/>
                            <TextBlock Text="Verzekeringen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="InsuranceCombo" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" MaxDropDownHeight="320" SelectionChanged="ProductCombo_SelectionChanged" Margin="0,0,0,14"/>
                            <TextBlock Text="Services en accessoires" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ServiceCombo" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" MaxDropDownHeight="320" SelectionChanged="ProductCombo_SelectionChanged" Margin="0,0,0,14"/>
                            <TextBlock Text="Aantal" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="QuantityBox" Text="1" Margin="0,0,0,18"/>
                            <Button Content="＋  Toevoegen aan bestelling" Click="AddItem_Click" Background="#21856B" Foreground="White" FontWeight="SemiBold" Height="46"/>
                          
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Huidige bestelling" FontSize="19" FontWeight="Bold" Foreground="#20364B"/>
                                <TextBlock x:Name="OrderInfo" Text="1 bestelling · 0 regels" FontSize="11" Foreground="#82909D" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Wijzigen" Click="EditItem_Click" Background="#E8F1F7" Foreground="#20364B" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="Leegmaken" Click="ClearOrder_Click" Background="#FCE9E7" Foreground="#B5473C" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="#F7F9FA" CornerRadius="8" Padding="12" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Klantbestelling" FontWeight="SemiBold" FontSize="14" Foreground="#20364B"/>
                                    <TextBlock x:Name="OrderSummaryDetails" Text="Nog geen producten toegevoegd" FontSize="12" Foreground="#82909D" TextWrapping="Wrap" Margin="0,5,8,0"/>
                                </StackPanel>
                                <TextBlock x:Name="OrderSummaryTotal" Grid.Column="1" Text="€ 0,00" FontWeight="Bold" Foreground="#21856B" VerticalAlignment="Center" Margin="8,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Separator/>
                            <Grid Margin="0,12,0,12">
                                <TextBlock Text="Totaal te betalen" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OrderTotal" Text="€ 0,00" FontSize="25" FontWeight="Bold" Foreground="#21856B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button Content="Naar betalen  →" Click="GoPayment_Click" Background="#20364B" Foreground="White" Height="46" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Betaalscherm -->
            <Grid x:Name="PaymentPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Afrekenen" FontSize="21" FontWeight="Bold" Foreground="#20364B"/>
                        <TextBlock Text="Controleer het bedrag en registreer de contante betaling." Foreground="#718096" Margin="0,4,0,18"/>
                        <TextBlock Text="TE BETALEN (CONTANT, AFGEROND OP 5 CENT)" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                        <TextBlock x:Name="PaymentTotal" Text="€ 0,00" FontSize="34" FontWeight="Bold" Foreground="#21856B" Margin="0,2,0,18"/>
                        <TextBlock Text="Ontvangen bedrag (€)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ReceivedBox" Text="0,00" FontSize="22" Height="54" TextChanged="ReceivedBox_TextChanged" Margin="0,0,0,12"/>
                        <TextBlock Text="Snel invoeren" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <UniformGrid Columns="4" Rows="2" Margin="0,0,0,18">
                            <Button Content="€ 5" Tag="5" Click="QuickCash_Click" Margin="3" Background="#EDF2F6"/>
                            <Button Content="€ 10" Tag="10" Click="QuickCash_Click" Margin="3" Background="#EDF2F6"/>
                            <Button Content="€ 20" Tag="20" Click="QuickCash_Click" Margin="3" Background="#EDF2F6"/>
                            <Button Content="€ 50" Tag="50" Click="QuickCash_Click" Margin="3" Background="#EDF2F6"/>
                            <Button Content="Exact" Tag="Exact" Click="QuickCash_Click" Margin="3" Background="#E5F3EE" Foreground="#176B55"/>
                            <Button Content="+ € 1" Tag="1" Click="AddCash_Click" Margin="3" Background="#EDF2F6"/>
                            <Button Content="+ € 2" Tag="2" Click="AddCash_Click" Margin="3" Background="#EDF2F6"/>
                            <Button Content="Wissen" Click="ClearCash_Click" Margin="3" Background="#FCE9E7" Foreground="#B5473C"/>
                        </UniformGrid>
                        <Border Background="#F2F7F5" CornerRadius="9" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PaymentStatus" Text="Nog te betalen" Foreground="#718096" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ChangeText" Grid.Row="1" Text="€ 0,00" FontSize="27" FontWeight="Bold" Foreground="#20364B" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="← Bestelling" Click="BackToOrder_Click" Background="#E9EEF2" Foreground="#20364B" Margin="0,0,10,0"/>
                            <Button Content="Betaling afronden" Click="FinishPayment_Click" Background="#21856B" Foreground="White" FontWeight="SemiBold" Padding="20,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Wisselgeld" FontSize="19" FontWeight="Bold" Foreground="#20364B"/>
                        <TextBlock Text="Terug te geven biljetten en munten" Foreground="#718096" FontSize="12" Margin="0,3,0,14"/>
                        <TextBlock x:Name="ChangeBreakdown" Text="Voer het ontvangen bedrag in." TextWrapping="Wrap" Foreground="#526273" FontSize="14"/>
                        <Separator Margin="0,18,0,14"/>
                        <TextBlock Text="Bestelling" FontWeight="Bold" Foreground="#20364B" Margin="0,0,0,8"/>
                        <ListBox x:Name="PaymentOrderList" BorderThickness="0" Background="#F7F9FA" Height="240" DisplayMemberPath="PaymentLine"/>
                        <TextBlock Text="Tip: gebruik 'Exact' als de klant gepast betaalt." Foreground="#82909D" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rekenmachine -->
            <Grid x:Name="CalculatorPage" Grid.Row="1" Visibility="Collapsed">
                <Border Background="White" CornerRadius="12" Padding="22" Width="390" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Rekenmachine" FontSize="20" FontWeight="Bold" Foreground="#20364B" Margin="0,0,0,14"/>
                        <TextBox x:Name="CalcDisplay" Text="0" FontSize="26" Height="62" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,0,0,12" KeyDown="CalcDisplay_KeyDown"/>
                        <UniformGrid Columns="4" Rows="6">
                            <Button Content="7" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="8" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="9" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="÷" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="4" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="5" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="6" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="×" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="1" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="2" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="3" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="-" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="0" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="," Click="CalcButton_Click" Margin="3"/>
                            <Button Content="%" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="+" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="(" Click="CalcButton_Click" Margin="3"/>
                            <Button Content=")" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="±" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="⌫" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="C" Click="CalcButton_Click" Margin="3" Background="#FCE9E7" Foreground="#B5473C"/>
                            <Button Content="CE" Click="CalcButton_Click" Margin="3"/>
                            <Button Content="=" Click="CalcButton_Click" Margin="3" Background="#21856B" Foreground="White" FontWeight="Bold"/>
                            <Button Content="Kopieer" Click="CopyResult_Click" Margin="3"/>
                        </UniformGrid>
                      
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Klokpagina -->
            <Grid x:Name="ClockPage"
      Grid.Row="1"
      Visibility="Collapsed">

                <Border Background="White"
            CornerRadius="8"
            Padding="24"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="KLOK"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#20364B"
                       HorizontalAlignment="Center"/>

                        <TextBlock x:Name="ClockDisplay"
                       Text="00:00:00"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#21856B"
                       HorizontalAlignment="Center"
                       Margin="0,18"/>

                        <TextBlock Text="Uren"
                       Foreground="#718096"/>

                        <TextBox x:Name="ClockHours"
                     Text="00"
                     MaxLength="2"
                     IsEnabled="False"
                     Width="150"
                     HorizontalContentAlignment="Center"
                     HorizontalAlignment="Center"/>

                        <TextBlock Text="Minuten"
                       Foreground="#718096"
                       Margin="0,8,0,0"/>

                        <TextBox x:Name="ClockMinutes"
                     Text="00"
                     MaxLength="2"
                     IsEnabled="False"
                     Width="150"
                     HorizontalContentAlignment="Center"
                     HorizontalAlignment="Center"/>

                        <TextBlock Text="Seconden"
                       Foreground="#718096"
                       Margin="0,8,0,0"/>

                        <TextBox x:Name="ClockSeconds"
                     Text="00"
                     MaxLength="2"
                     IsEnabled="False"
                     Width="150"
                     HorizontalContentAlignment="Center"
                     HorizontalAlignment="Center"/>

                        <Button x:Name="ClockButton"
                    Content="Set time"
                    Click="ClockButton_Click"
                    Margin="3,18,3,3"
                    Height="40"/>

                    </StackPanel>
                </Border>
            </Grid>


        </Grid>
    </Grid>
</Window>
