<Window x:Class="DeFluitendeFietser.BestelpaginaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <SolidColorBrush x:Key="DonkerBlauw" Color="#163B50"/>
        <SolidColorBrush x:Key="Groen" Color="#168575"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource DonkerBlauw}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,18">

            <StackPanel>
                <TextBlock Text="De Fluitende Fietser"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Fietsverhuur - Facturering"
                           FontSize="16"
                           Foreground="#D6E7ED"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

       
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

     
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Artikel toevoegen"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DonkerBlauw}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Fietsen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="cmbFietsen"
                                  Height="40"
                                  FontSize="14"
                                  DisplayMemberPath="Weergave"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Verzekeringen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="cmbVerzekeringen"
                                  Height="40"
                                  FontSize="14"
                                  DisplayMemberPath="Weergave"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Services"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="cmbServices"
                                  Height="40"
                                  FontSize="14"
                                  DisplayMemberPath="Weergave"
                                  SelectionChanged="ComboBox_SelectionChanged"
                                  Margin="0,0,0,20"/>

                        <TextBlock Text="Aantal dagen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txtDagen"
                                 Text="1"
                                 Height="40"
                                 FontSize="16"
                                 Padding="10,7"
                                 MaxLength="3"
                                 Margin="0,0,0,18"/>

                        <Button Content="Bestel artikel"
                                Height="48"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="{StaticResource Groen}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BestelArtikel_Click"/>

                        <TextBlock Text="Kies één artikel tegelijk."
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

   
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Besteloverzicht"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource DonkerBlauw}"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1"
                               Text="Dubbelklik op een regel om deze te verwijderen."
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="lstBestelling"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="#F8FAFC"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             MouseDoubleClick="lstBestelling_MouseDoubleClick">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="3">

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <StackPanel Width="105"
                                                    Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Naam}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Categorie}"
                                                       FontSize="10"
                                                       Foreground="#64748B"/>
                                        </StackPanel>

                                        <StackPanel Width="70"
                                                    Margin="0,0,5,0">
                                            <TextBlock Text="Per dag"
                                                       FontSize="10"
                                                       Foreground="#64748B"/>
                                            <TextBlock Text="{Binding PrijsTekst}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Width="45"
                                                    Margin="0,0,5,0">
                                            <TextBlock Text="Dagen"
                                                       FontSize="10"
                                                       Foreground="#64748B"/>
                                            <TextBlock Text="{Binding Dagen}"/>
                                        </StackPanel>

                                        <StackPanel Width="85"
                                                    Margin="0,0,5,0">
                                            <TextBlock Text="Totaal"
                                                       FontSize="10"
                                                       Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TotaalTekst}"
                                                       FontWeight="Bold"
                                                       Foreground="#168575"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Content="X"
                                                Width="28"
                                                Height="28"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderThickness="0"
                                                Tag="{Binding}"
                                                ToolTip="Verwijder artikel"
                                                Click="VerwijderArtikel_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Background="#E8F5F1"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,12,0,0">

                        <StackPanel>
                            <TextBlock Text="Te betalen bedrag"
                                       FontSize="15"
                                       Foreground="#315D55"/>

                            <TextBlock x:Name="txtTotaal"
                                       Text="€ 0,00"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#126B5C"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

   
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="14"
                Margin="0,18,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <TextBlock x:Name="txtTimer"
                               Text="Applicatie sluit over 60 seconden"
                               FontSize="12"
                               Foreground="#475569"/>

                    <ProgressBar x:Name="pbTimer"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="60"
                                 Value="60"
                                 Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Volgende klant"
                        Padding="18,12"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="{StaticResource DonkerBlauw}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="VolgendeKlant_Click"/>
            </Grid>
        </Border>
    </Grid>



</Window>
