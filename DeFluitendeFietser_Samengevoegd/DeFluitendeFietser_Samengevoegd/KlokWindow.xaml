<Window x:Class="DeFluitendeFietser.KlokWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="650">


    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#E8F1FA"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,25">

            <TextBlock x:Name="ClockText"
                       Text="00:00:00"
                       FontSize="72"
                       FontWeight="Bold"
                       TextAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D5D9DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

            <StackPanel>
                <TextBlock Text="Tijd instellen"
                           FontSize="24"
                           Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Uur"
                                   FontSize="18"
                                   TextAlignment="Center"/>
                        <TextBox x:Name="HoursBox"
                                 Text="14"
                                 FontSize="24"
                                 Padding="8"
                                 TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Minuut"
                                   FontSize="18"
                                   TextAlignment="Center"/>
                        <TextBox x:Name="MinutesBox"
                                 Text="23"
                                 FontSize="24"
                                 Padding="8"
                                 TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Seconde"
                                   FontSize="18"
                                   TextAlignment="Center"/>
                        <TextBox x:Name="SecondsBox"
                                 Text="5"
                                 FontSize="24"
                                 Padding="8"
                                 TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="10,25,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Start"
                            Click="StartButton_Click"
                            Height="55"
                            Margin="5"
                            FontSize="20"
                            Background="#218838"
                            Foreground="White"/>

                    <Button Grid.Column="1"
                            Content="Reset"
                            Click="ResetButton_Click"
                            Height="55"
                            Margin="5"
                            FontSize="20"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

</Window>
