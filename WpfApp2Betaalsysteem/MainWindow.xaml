<Window x:Class="WpfApp2Betaalsysteem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2Betaalsysteem"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="950">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="320"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            
            <StackPanel Grid.Column="0" Margin="15">
                <TextBlock Text="Ontvangen geld van klant" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">

                   
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock Text="Bankbiljetten" FontWeight="Bold" Margin="0,0,0,6"/>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/eur200.png" Width="70" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt0" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="0" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="0" Click="MinKlik"/>
                        </StackPanel>

                       
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/eur100.png" Width="70" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt1" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="1" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="1" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/eur50.png" Width="70" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt2" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="2" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="2" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/eur20.png" Width="70" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt3" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="3" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="3" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/eur10.png" Width="70" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt4" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="4" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="4" Click="MinKlik"/>
                        </StackPanel>

                      
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/eur5.png" Width="70" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt5" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="5" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="5" Click="MinKlik"/>
                        </StackPanel>
                    </StackPanel>

                   
                    <StackPanel>
                        <TextBlock Text="Munten" FontWeight="Bold" Margin="0,0,0,6"/>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/munt200.png" Width="35" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt6" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="6" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="6" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/munt100.png" Width="35" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt7" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="7" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="7" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/munt050.png" Width="35" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt8" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="8" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="8" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/munt020.png" Width="35" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt9" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="9" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="9" Click="MinKlik"/>
                        </StackPanel>

                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/munt010.png" Width="35" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt10" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="10" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="10" Click="MinKlik"/>
                        </StackPanel>

                       
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Images/munt005.png" Width="35" Height="35" Stretch="Uniform"/>
                            <TextBox x:Name="txt11" Text="0" Width="40" Height="30" Margin="8,0,0,0"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Background="#EEEEEE"/>
                            <Button Content="+" Width="25" Height="30" Margin="4,0,0,0" Tag="11" Click="PlusKlik"/>
                            <Button Content="-" Width="25" Height="30" Margin="2,0,0,0" Tag="11" Click="MinKlik"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                
                <StackPanel Margin="0,15,0,0">
                    <TextBlock FontSize="18" FontWeight="Bold">
                        <Run Text="Totaal gegeven: "/>
                        <Run x:Name="TotalGivenRun" Text="€ 0,00"/>
                    </TextBlock>

                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,4,0,10">
                        <Run x:Name="RetourLabelRun" Text="Totaal retour: "/>
                        <Run x:Name="TotalReturnRun" Text="€ 0,00"/>
                    </TextBlock>

                    <TextBlock Text="Retour in biljetten/munten:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="RetourListBox" Height="100"/>
                </StackPanel>
            </StackPanel>

            
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock FontSize="20" FontWeight="DemiBold" Text="Orders:"/>
                    <TextBox x:Name="OrdersTextBox" Height="80"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock FontSize="15" FontWeight="DemiBold" VerticalAlignment="Center"
                               Text="Totalprice orders = €"/>
                    <TextBox x:Name="TotaalPrijsTextBox" Width="80" Height="30" Margin="4,0,0,0"
                             VerticalAlignment="Center" Text="0"
                             PreviewTextInput="TotaalPrijsTextBox_PreviewTextInput"
                             LostFocus="TotaalPrijsTextBox_LostFocus"
                             TextChanged="TotaalPrijsTextBox_TextChanged"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="150"></ColumnDefinition>
                <ColumnDefinition Width="150"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1">Calculator</Button>
            <Button Grid.Column="2">Timer</Button>
        </Grid>

    </Grid>
</Window>
